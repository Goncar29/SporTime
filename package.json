{
  "name": "sportime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc --noEmit && vp build",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:e2e": "playwright test",
    "test:emulator": "firebase emulators:exec --only auth,firestore --project demo-sportime \"playwright test --config playwright.emulator.config.ts\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-sportime \"vp test run --config vitest.rules.config.ts\"",
    "prepare": "vp config"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.34.2",
    "jsdom": "^27.0.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
