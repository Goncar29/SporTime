rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasExactly(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function intBetween(value, min, max) {
      return value is int && value >= min && value <= max;
    }

    // Limits mirror LIMITS in src/workouts/domain/workout.ts; firestore/rules.test.ts keeps them in step.
    // Beyond this a JavaScript Date is invalid; mirrors MAX_TIMESTAMP_MS in src/shared/domain/timestamp.ts.
    function isTimestamp(value) {
      return intBetween(value, 0, 8640000000000000);
    }

    // Names are optional, so configs written before they existed stay valid. They are stored as
    // one string, a round per line (toStoredConfig in src/workouts/domain/workout.ts), because rules
    // cannot loop over a list to check that every item is text. Each line is empty or a trimmed
    // name of at most 24 characters (MAX_ROUND_NAME_LENGTH); the last line is never empty.
    function isRoundNames(names, config) {
      return names is string
        && names.size() <= 2474
        && config.mode in ['emom', 'tabata', 'intervals']
        && names.split('\n').size() <= config.rounds
        && names.matches('((\\S([^\\n]{0,22}\\S)?)?\\n)*\\S([^\\n]{0,22}\\S)?');
    }

    function isConfig(config) {
      return config is map
        && config.keys().hasAll(['mode', 'prepareSeconds', 'workSeconds', 'restSeconds', 'rounds', 'sets', 'setRestSeconds'])
        && config.keys().hasOnly(['mode', 'prepareSeconds', 'workSeconds', 'restSeconds', 'rounds', 'sets', 'setRestSeconds', 'roundNames'])
        && (!('roundNames' in config) || isRoundNames(config.roundNames, config))
        && config.mode in ['stopwatch', 'forTime', 'amrap', 'emom', 'tabata', 'intervals']
        && intBetween(config.prepareSeconds, 0, 300)
        && intBetween(config.workSeconds, 1, 10800)
        && intBetween(config.restSeconds, 0, 3600)
        && intBetween(config.rounds, 1, 99)
        && intBetween(config.sets, 1, 20)
        && intBetween(config.setRestSeconds, 0, 3600);
    }

    function isWorkout(data) {
      return hasExactly(data, ['name', 'config', 'createdAt'])
        && data.name is string
        && data.name.size() <= 40
        && data.name.trim().size() > 0
        && isConfig(data.config)
        && isTimestamp(data.createdAt);
    }

    function isHistoryEntry(data) {
      return hasExactly(data, ['config', 'finishedAt', 'activeMs', 'marks'])
        && isConfig(data.config)
        && isTimestamp(data.finishedAt)
        && intBetween(data.activeMs, 0, 604800000)
        && intBetween(data.marks, 0, 10000);
    }

    // Routine limits mirror ROUTINE_LIMITS in src/routines/domain/routine.ts; firestore/rules.test.ts
    // keeps them in step. Every field but the routine's name is optional.

    // One line of text with something visible and no control character. One pattern checks both,
    // which costs fewer of the 1000 expressions a write may evaluate than trim() as well.
    function isLine(value, max) {
      return value is string
        && value.size() <= max
        && value.matches('[^\\p{Cc}]*[^\\p{Cc}\\p{Z}][^\\p{Cc}]*');
    }

    // Text that may span lines, with something visible; no other control character.
    function isNotes(value, max) {
      return value is string
        && value.size() <= max
        && value.matches('[^\\x00-\\x09\\x0B-\\x1F\\x7F-\\x9F]*[^\\p{Cc}\\p{Z}][^\\x00-\\x09\\x0B-\\x1F\\x7F-\\x9F]*');
    }

    // Exercises are one string, an exercise per line (toStoredRoutine), because rules cannot loop
    // over a list: name, reps (8 or 8-10, 1 to 999), rest seconds (0 to 3600), weight (0 to 1000,
    // one decimal, kg or lb), notes and link, separated by tabs, each field possibly empty.
    // Every line has all six fields (lines without the link field were never published).
    // The pattern is one literal, written out in full, because Firestore stops a write after
    // 1000 evaluated expressions and building it from parts costs some for every stage. Per line:
    //   name   [^\p{Cc}]{0,40}
    //   reps   ([1-9][0-9]{0,2}(-[1-9][0-9]{0,2})?)?
    //   rest   (3600|3[0-5][0-9][0-9]|[12][0-9]{3}|[1-9][0-9]{0,2}|0)?
    //   weight ((1000(\.0)?|([1-9][0-9]{0,2}|0)(\.[0-9])?)(kg|lb))?
    //   notes  [^\p{Cc}]{0,120}
    //   link   (https://[^\p{Cc}\p{Z}@/?#\\]{1,292}([/?#\\][^\p{Cc}\p{Z}]{0,291})?)?
    // and then the same again for every further line, after a line break.
    // A link is https only, with a host and no space or control character, and no `@` before the
    // first / ? # or \ so it never carries a user or password (an @ later, like youtube.com/@x, is
    // a path). The host and the rest are each bounded by the app's 300 characters; a pattern cannot
    // bound their sum, so a link of up to 592 passes here and the app drops it when reading.
    // The app (normalizeLink) also refuses other invisible characters; this pattern stays looser.
    // A link must name an internet site, never the local network or an IP address (S12). The
    // second pattern finds a link field (after a tab, the last on its line) whose host, in any
    // letter case, is bracketed (IPv6), ends in a number or a 0x number (any IPv4 form a browser
    // reads, like 3232235521, 0xC0A80001 or 127.1; or no address at all), is localhost or ends in
    // .localhost, .local, .lan, .internal or .home.arpa, or is one name with no dot. A dot here is
    // also U+3002, U+FF0E or U+FF61, which browsers read as one. The app (LOCAL_HOST_AS_TYPED in
    // src/routines/domain/routine.ts) refuses the same text with the same pattern.
    // Up to 10 stages are checked per write, so each check here is kept to the fewest expressions:
    // a value of the wrong type makes split() or matches() fail, and a failure refuses the write.
    function isExercises(value) {
      return value == ''
          || (value.split('\n').size() <= 15
            && value.matches('[^\\p{Cc}]{0,40}\\t([1-9][0-9]{0,2}(-[1-9][0-9]{0,2})?)?\\t(3600|3[0-5][0-9][0-9]|[12][0-9]{3}|[1-9][0-9]{0,2}|0)?\\t((1000(\\.0)?|([1-9][0-9]{0,2}|0)(\\.[0-9])?)(kg|lb))?\\t[^\\p{Cc}]{0,120}\\t(https://[^\\p{Cc}\\p{Z}@/?#\\\\]{1,292}([/?#\\\\][^\\p{Cc}\\p{Z}]{0,291})?)?(\\n[^\\p{Cc}]{0,40}\\t([1-9][0-9]{0,2}(-[1-9][0-9]{0,2})?)?\\t(3600|3[0-5][0-9][0-9]|[12][0-9]{3}|[1-9][0-9]{0,2}|0)?\\t((1000(\\.0)?|([1-9][0-9]{0,2}|0)(\\.[0-9])?)(kg|lb))?\\t[^\\p{Cc}]{0,120}\\t(https://[^\\p{Cc}\\p{Z}@/?#\\\\]{1,292}([/?#\\\\][^\\p{Cc}\\p{Z}]{0,291})?)?)*')
            && !value.matches('(?i)[\\s\\S]*\\thttps://(\\[[^\\t\\n]*|([^:/?#\\\\\\t\\n]*[.\\x{3002}\\x{FF0E}\\x{FF61}])?([0-9]+|0x[0-9a-f]*|localhost|local|lan|internal|home[.\\x{3002}\\x{FF0E}\\x{FF61}]arpa)[.\\x{3002}\\x{FF0E}\\x{FF61}]?|[^.\\x{3002}\\x{FF0E}\\x{FF61}:/?#\\\\\\t\\n]+[.\\x{3002}\\x{FF0E}\\x{FF61}]?)([:/?#\\\\][^\\t\\n]*)?(\\n[\\s\\S]*)?'));
    }

    // A stage name of 1 to 40 characters and notes of 1 to 500, both without control characters
    // (notes may hold line breaks). A blank one is harmless: the app ignores it when reading.
    // A missing `exercises` fails to evaluate, which refuses the write.
    function isStage(stage) {
      return stage.keys().hasOnly(['name', 'notes', 'exercises'])
        && (!('name' in stage) || stage.name.matches('[^\\p{Cc}]{1,40}'))
        && (!('notes' in stage) || stage.notes.matches('[^\\x00-\\x09\\x0B-\\x1F\\x7F-\\x9F]{1,500}'))
        && isExercises(stage.exercises);
    }

    // Checked one position at a time, up to the limit of 10 stages.
    function isStages(stages) {
      return stages is list
        && stages.size() <= 10
        && (stages.size() < 1 || isStage(stages[0]))
        && (stages.size() < 2 || isStage(stages[1]))
        && (stages.size() < 3 || isStage(stages[2]))
        && (stages.size() < 4 || isStage(stages[3]))
        && (stages.size() < 5 || isStage(stages[4]))
        && (stages.size() < 6 || isStage(stages[5]))
        && (stages.size() < 7 || isStage(stages[6]))
        && (stages.size() < 8 || isStage(stages[7]))
        && (stages.size() < 9 || isStage(stages[8]))
        && (stages.size() < 10 || isStage(stages[9]));
    }

    function isRoutine(data) {
      return data.keys().hasAll(['name', 'stages', 'createdAt'])
        && data.keys().hasOnly(['name', 'notes', 'stages', 'createdAt'])
        && isLine(data.name, 40)
        && (!('notes' in data) || isNotes(data.notes, 500))
        && isStages(data.stages)
        && isTimestamp(data.createdAt);
    }

    // A name as the directory keeps it (directoryName): one line of up to 100 characters, possibly
    // empty. Limits mirror DIRECTORY_LIMITS in src/directory/domain/directory.ts.
    function isDirectoryName(name) {
      return name is string
        && name.size() <= 100
        && name.matches('[^\\p{Cc}]*');
    }

    // Empty, or an https address on googleusercontent.com with only the host before the path, so
    // it carries no credentials or port; same pattern as isGooglePhoto.
    function isGooglePhoto(photo) {
      return photo == ''
        || (photo.size() <= 500
          && photo.matches('https://([a-z0-9-]+\\.)*googleusercontent\\.com/[^\\p{Cc}\\p{Z}]*'));
    }

    // A directory entry, as directoryEntryFor writes it. The photo may also be absent.
    function isDirectoryEntry(data) {
      return data.keys().hasAll(['uid', 'name'])
        && data.keys().hasOnly(['uid', 'name', 'photo'])
        && data.uid == request.auth.uid
        && isDirectoryName(data.name)
        && (!('photo' in data) || isGooglePhoto(data.photo));
    }

    // A contact, as toStoredContact writes it; limits mirror CONTACT_LIMITS in
    // src/contacts/domain/contact.ts. Its id is the contact's uid, never the owner's. The email
    // is one address (no space, slash or control character) under which that very uid is listed
    // in the directory now, so nobody can be added who did not choose to be found; this read is
    // the one get a write here costs. Only the app keeps the limit of 50: rules cannot count.
    function isContact(uid, contactUid, data) {
      return hasExactly(data, ['uid', 'name', 'photo', 'email'])
        && data.uid == contactUid
        && contactUid != uid
        && isDirectoryName(data.name)
        && isGooglePhoto(data.photo)
        && data.email.size() <= 254
        && data.email.matches('[^\\p{Cc}\\p{Z}/@]+@[^\\p{Cc}\\p{Z}/@]+')
        && get(/databases/$(database)/documents/directory/$(data.email)).data.uid == contactUid;
    }

    // Only the signed-in owner of a verified email may list it, under that email trimmed and in
    // lower case (normalizeEmail), so nobody can claim an address that is not theirs.
    function ownsEmail(email) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.trim().lower() == email;
    }

    // A routine another user sends (S12) is checked more strictly than one's own (L7 A1), so the
    // recipient's app never drops part of it when reading: every text starts with something
    // visible (a blank, space-only or zero-width-only name, stage name or notes is refused), a
    // stage holds something, no exercise line is empty and a rep range always goes up. The limits
    // are those of isRoutine. A link's host may hold only ASCII letters, digits, - and . (no
    // full-width, enclosed or other look-alike character a browser turns into an IP address or a
    // local name, no percent escape), with at least one dot, and ends in a top-level name of 2 to
    // 63 letters (or xn-- and letters, digits or -) that is not localhost, local, lan, internal
    // or arpa; a port is digits. So digits, 0x numbers, brackets and single names never pass.
    // That host check lives in the first pattern below (the one a line must match, so no second
    // pattern for local hosts as in isExercises), written out in full from these parts, joined by
    // tabs, a line and then the same again for every further line:
    //   name   (V[^\p{Cc}]{0,39})?                     starts with something visible
    //   reps   ([1-9]\d{0,2}(-[1-9]\d{0,2})?)?
    //   rest   (3600|3[0-5]\d\d|[12]\d{3}|[1-9]\d{0,2}|0)?
    //   weight ((1000(\.0)?|([1-9]\d{0,2}|0)(\.\d)?)(kg|lb))?
    //   notes  (V[^\p{Cc}]{0,119})?
    //   link   (https://[A-Za-z0-9][A-Za-z0-9.-]{0,226}\.TOP\.?(:\d{1,5})?([/?#\\][^\p{C}\p{Z}]{0,291})?)?
    // V, the first character of every text here (stage and routine names and notes too), is
    // [^\p{C}\p{Z}] and also none of U+061C, U+08E2, U+0890-0891, U+110BD, U+110CD,
    // U+13430-1345F, U+1BCA0-1BCA3, U+2060-206F, U+FFF0-FFFF, U+E0000-E0FFF: invisible or
    // unassigned characters the rules engine's older Unicode tables do not count in \p{C}, while
    // the app does, so text of only those would be dropped on reading. Not a positive class like
    // \p{L}, which would refuse a name starting with an emoji newer than those tables.
    // TOP spells out, letter by letter in both cases, every name of 2 to 63 letters but
    // the five above, or xn-- and up to 59 letters, digits or -. The other three patterns find
    // what a line pattern cannot say, and refuse it: more than 15 lines; an empty line (also a
    // leading, trailing or doubled line break) or a line of six empty fields; reps whose second
    // number is not greater than the first (10-8, 10-10). Rules have no back-references, so the
    // last lists every such pair of 1 to 999 by its digits; Firestore refuses a pattern longer
    // than 4096 characters, so that list is split over three patterns. Firestore stops a write
    // after 1000 evaluated expressions: a copy of 11 full stages fits, 12 do not, so the limit of
    // 10 keeps one stage of headroom, as for one's own routines.
    function isSharedExercises(value) {
