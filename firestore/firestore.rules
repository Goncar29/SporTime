        && stage.get('notes', 'x').matches('[^\\p{C}\\p{Z}\\x{061C}\\x{08E2}\\x{0890}-\\x{0891}\\x{110BD}\\x{110CD}\\x{13430}-\\x{1345F}\\x{1BCA0}-\\x{1BCA3}\\x{2060}-\\x{206F}\\x{FFF0}-\\x{FFFF}\\x{E0000}-\\x{E0FFF}][^\\x00-\\x09\\x0B-\\x1F\\x7F-\\x9F]{0,499}')
