      return stages is list
        && n <= 10
        && (n < 1 || isSharedStage(stages[0]))
        && (n < 2 || isSharedStage(stages[1]))
        && (n < 3 || isSharedStage(stages[2]))
        && (n < 4 || isSharedStage(stages[3]))
        && (n < 5 || isSharedStage(stages[4]))
        && (n < 6 || isSharedStage(stages[5]))
        && (n < 7 || isSharedStage(stages[6]))
        && (n < 8 || isSharedStage(stages[7]))
        && (n < 9 || isSharedStage(stages[8]))
        && (n < 10 || isSharedStage(stages[9]));
