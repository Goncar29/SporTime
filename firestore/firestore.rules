rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasExactly(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function intBetween(value, min, max) {
      return value is int && value >= min && value <= max;
    }

    // Limits mirror LIMITS in src/workouts/domain/workout.ts; firestore/rules.test.ts keeps them in step.
    // Beyond this a JavaScript Date is invalid; mirrors MAX_TIMESTAMP_MS in src/shared/domain/timestamp.ts.
    function isTimestamp(value) {
      return intBetween(value, 0, 8640000000000000);
    }

    function isConfig(config) {
      return config is map
        && hasExactly(config, ['mode', 'prepareSeconds', 'workSeconds', 'restSeconds', 'rounds', 'sets', 'setRestSeconds'])
        && config.mode in ['stopwatch', 'forTime', 'amrap', 'emom', 'tabata', 'intervals']
        && intBetween(config.prepareSeconds, 0, 300)
        && intBetween(config.workSeconds, 1, 10800)
        && intBetween(config.restSeconds, 0, 3600)
        && intBetween(config.rounds, 1, 99)
        && intBetween(config.sets, 1, 20)
        && intBetween(config.setRestSeconds, 0, 3600);
    }

    function isWorkout(data) {
      return hasExactly(data, ['name', 'config', 'createdAt'])
        && data.name is string
        && data.name.size() <= 40
        && data.name.trim().size() > 0
        && isConfig(data.config)
        && isTimestamp(data.createdAt);
    }

    function isHistoryEntry(data) {
      return hasExactly(data, ['config', 'finishedAt', 'activeMs', 'marks'])
        && isConfig(data.config)
        && isTimestamp(data.finishedAt)
        && intBetween(data.activeMs, 0, 604800000)
        && intBetween(data.marks, 0, 10000);
    }

    // The SDK resends a write when its answer was lost, so an identical rewrite must succeed.
    function isUnchanged() {
      return request.resource.data == resource.data;
    }

    // Anything not matched below is denied by default.
    match /users/{uid}/workouts/{workoutId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && isWorkout(request.resource.data);
      allow update: if isOwner(uid) && isUnchanged();
    }

    match /users/{uid}/history/{entryId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && isHistoryEntry(request.resource.data);
      allow update: if isOwner(uid) && isUnchanged();
    }
  }
}
